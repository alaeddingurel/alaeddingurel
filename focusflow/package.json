{
  "name": "focusflow",
  "private": true,
  "version": "0.1.0",
  "description": "AI-enhanced, highly customizable Pomodoro timer with accounts, Pro analytics and a focus coach.",
  "workspaces": ["shared", "server", "web"],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed --workspace server"
  },
  "engines": { "node": ">=22.13" }
}

# Copy to .env (in this folder) and adjust. All values are optional.

# API port (the Vite dev server proxies /api here)
PORT=8787

# SQLite file location
DATABASE_FILE=data/focusflow.db

# --- AI coach ---
# With an Anthropic API key set, Pro reports and the day planner are written by Claude.
# Without one, FocusFlow uses its built-in heuristics engine (fully functional, no network calls).
# ANTHROPIC_API_KEY=sk-ant-...
# Force on/off regardless of key detection: claude | off
# FOCUSFLOW_AI=claude
# FOCUSFLOW_AI_MODEL=claude-opus-5-5

# --- Billing ---
# The demo server upgrades to Pro instantly for free. Set to "disabled" to turn self-upgrades off.
# BILLING_MODE=disabled

# Allow the session cookie over plain HTTP when NODE_ENV=production (local testing only)
# INSECURE_COOKIES=1
